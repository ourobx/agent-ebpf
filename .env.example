# =============================================================================
# Agent-eBPF Environment Configuration (REQUIRED — copy to .env and fill in)
# In production (ENVIRONMENT=production) the server FAILS FAST on startup if
# any of the critical values below are missing. No synthetic fallbacks exist.
# =============================================================================

# Runtime environment: production | development | test
ENVIRONMENT=development

# --- PostgreSQL (REQUIRED in production) ---
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://agent_user:CHANGE_ME@127.0.0.1:5432/agent_ebpf_db
POSTGRES_PASSWORD=CHANGE_ME

# --- JWT / OAuth (REQUIRED in production) ---
# Use a long random value (e.g. `python -c "import secrets; print(secrets.token_hex(64))"`)
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
OAUTH_CLIENT_ID=agent-ebpf-client
OAUTH_CLIENT_SECRET=CHANGE_ME_TO_A_RANDOM_CLIENT_SECRET

# --- Security / CORS ---
# Comma-separated list of allowed origins (production default includes ksec.space)
CORS_ORIGINS=https://ksec.space,http://localhost:8000,http://localhost:3000

# --- eBPF / runtime ---
XDP_INTERFACE=eth0
POLICY_FILE=policy.yaml
MCP_TOOL_TIMEOUT=30
PORT=8000

# --- ClickHouse Telemetry Database ---
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=ksec_telemetry
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# --- Redis Cache & Metering Engine ---
REDIS_URL=redis://redis:6379/0

# --- Stripe Billing & SaaS Metering ---
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# --- Gemini AI Policy Compiler ---
GEMINI_API_KEY=AIzaSy_CHANGE_ME

# --- Next.js Frontend Ingress ---
NEXT_PUBLIC_API_URL=https://api.ksec.space

# --- Cloudflare Argo Tunnel Ingress (ksec.space / api.ksec.space / grpc.ksec.space) ---
CLOUDFLARE_TUNNEL_ID=CHANGE_ME_TO_YOUR_TUNNEL_UUID
CLOUDFLARE_TUNNEL_TARGET=CHANGE_ME_TO_YOUR_TUNNEL_UUID.cfargotunnel.com
TUNNEL_TOKEN=
