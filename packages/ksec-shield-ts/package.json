{
  "name": "@ourobx/shield",
  "version": "1.0.0",
  "description": "Kernel-level Zero-Trust Security SDK for AI Agents and LLMs via Agent-eBPF",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "ksec-shield": "./bin/ksec-shield.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js",
      "require": "./dist/auto.js"
    },
    "./ai": {
      "types": "./dist/interceptors/vercel-ai.d.ts",
      "import": "./dist/interceptors/vercel-ai.js",
      "require": "./dist/interceptors/vercel-ai.js"
    },
    "./engine": {
      "types": "./dist/engine/in-memory-matcher.d.ts",
      "import": "./dist/engine/in-memory-matcher.js",
      "require": "./dist/engine/in-memory-matcher.js"
    },
    "./transport": {
      "types": "./dist/transport/uds-client.d.ts",
      "import": "./dist/transport/uds-client.js",
      "require": "./dist/transport/uds-client.js"
    },
    "./presets": {
      "types": "./dist/presets/index.d.ts",
      "import": "./dist/presets/index.js",
      "require": "./dist/presets/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry/index.d.ts",
      "import": "./dist/telemetry/index.js",
      "require": "./dist/telemetry/index.js"
    },
    "./langchain": {
      "types": "./dist/interceptors/langchain.d.ts",
      "import": "./dist/interceptors/langchain.js",
      "require": "./dist/interceptors/langchain.js"
    },
    "./providers": {
      "types": "./dist/interceptors/providers.d.ts",
      "import": "./dist/interceptors/providers.js",
      "require": "./dist/interceptors/providers.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ourobx/agent-ebpf.git",
    "directory": "packages/ksec-shield-ts"
  },
  "homepage": "https://ksec.space",
  "scripts": {
    "build": "tsc",
    "test": "npx --yes tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "ai": "^3.0.0 || ^4.0.0",
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "keywords": [
    "ebpf",
    "security",
    "ai-agent",
    "llm-security",
    "zero-trust",
    "cli",
    "vercel-ai",
    "ai-sdk",
    "presets",
    "ipc",
    "uds",
    "opentelemetry",
    "otel",
    "langchain",
    "crewai",
    "claude",
    "gemini",
    "deepseek",
    "ksec"
  ],
  "author": "Sysauto <dev@sysauto.org>",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  }
}
