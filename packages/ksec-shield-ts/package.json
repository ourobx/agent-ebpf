{
  "name": "@ourobx/shield",
  "version": "1.0.0",
  "description": "Kernel-level Zero-Trust Security SDK for AI Agents and LLMs via Agent-eBPF",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js",
      "require": "./dist/auto.js"
    },
    "./langchain": {
      "types": "./dist/interceptors/langchain.d.ts",
      "import": "./dist/interceptors/langchain.js",
      "require": "./dist/interceptors/langchain.js"
    },
    "./providers": {
      "types": "./dist/interceptors/providers.d.ts",
      "import": "./dist/interceptors/providers.js",
      "require": "./dist/interceptors/providers.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ourobx/agent-ebpf.git",
    "directory": "packages/ksec-shield-ts"
  },
  "homepage": "https://ksec.space",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ebpf",
    "security",
    "ai-agent",
    "llm-security",
    "zero-trust",
    "langchain",
    "crewai",
    "claude",
    "gemini",
    "deepseek",
    "ksec"
  ],
  "author": "Sysauto <dev@sysauto.org>",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
